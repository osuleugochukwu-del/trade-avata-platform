---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { courses } from '../../data/site.js';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Learn — Trade Avata" description="Trade Avata learning resources and course previews.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Learn</span><h1>Learn with a clear path.</h1><p>Trade Avata education supports the products and tools we build. Public previews stay simple while protected learning will connect to the backend in a later phase.</p></div></section>
  <section class="section"><div class="container"><div class="grid-3">{courses.map(course => <article class="card course-card"><div class="product-image"><img src={`${base}images/hero-laptop.png`} alt="Trading workstation" /></div><span class="pill">{course.level}</span><h3>{course.title}</h3><p>{course.description}</p><div class="meta-row"><span>{course.modules} modules</span><span>{course.lessons} lessons</span><span>{course.duration}</span></div><a class="button button-small button-outline" href={`${base}contact/`}>Course preview</a></article>)}</div></div></section>
</BaseLayout>
