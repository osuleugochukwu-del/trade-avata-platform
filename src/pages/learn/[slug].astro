---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { courses } from '../../data/site.js';
const base = import.meta.env.BASE_URL;
export function getStaticPaths() {
  return courses.map(course => ({ params: { slug: course.slug }, props: { course } }));
}
const { course } = Astro.props;
---
<BaseLayout title={`${course.title} — Trade Avata`} description={course.description}>
  <section class="page-hero course-detail-hero"><div class="container">
    <a class="breadcrumb" href={`${base}learn/`}>← Learn</a>
    <span class="eyebrow">{course.level}</span>
    <h1>{course.title}</h1>
    <p>{course.description}</p>
    <div class="meta-row"><span>{course.modules} modules</span><span>{course.lessons} lessons</span><span>{course.duration}</span></div>
  </div></section>
  <section class="section"><div class="container course-detail-grid">
    <article class="card course-preview-card">
      <span class="eyebrow">Public preview</span>
      <h2>See how the course is structured.</h2>
      <p>This public course page is the lightweight front end. Protected enrollment, lesson progress, sequential unlocking and member access will connect to the backend learning layer.</p>
      <div class="course-outline">
        {Array.from({ length: Math.min(course.modules, 6) }, (_, i) => <div class="outline-row"><span>{String(i + 1).padStart(2, '0')}</span><div><strong>Module {i + 1}</strong><small>Course module preview</small></div><span>Locked</span></div>)}
      </div>
      <div class="actions"><a class="button" href={`${base}register/`}>Create account</a><a class="button button-outline" href={`${base}login/`}>Log in</a></div>
    </article>
    <aside class="card course-delivery-card">
      <span class="eyebrow">Delivery</span>
      <h2>{course.delivery.type}</h2>
      <p>{course.delivery.label}</p>
      <p class="meta">Video hosting and protected course access are intentionally separated from the public website.</p>
      <a class="button button-outline" href={`${base}contact/`}>Ask about the course</a>
    </aside>
  </div></section>
</BaseLayout>
