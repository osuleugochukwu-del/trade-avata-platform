---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/site.js';

const publicProducts = products.filter(p => p.visible);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Products — Trade Avata">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Products</span>

      <h1>Products for smarter trading.</h1>

      <p>
        Browse indicators, applications, tools and resources.
        The production catalogue will be controlled from the
        Trade Avata backend.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">

      <!-- FILTERS -->
      <div class="filter-bar">
        <input
          aria-label="Search products"
          placeholder="Search products…"
        />

        <select aria-label="Platform">
          <option>All platforms</option>
          <option>Web</option>
          <option>cTrader</option>
          <option>MT5</option>
          <option>Windows</option>
          <option>Android</option>
        </select>

        <select aria-label="Price">
          <option>All prices</option>
          <option>Free</option>
          <option>Paid</option>
          <option>Hidden price</option>
        </select>

        <select aria-label="Availability">
          <option>All availability</option>
          <option>Available</option>
          <option>Coming soon</option>
          <option>Planned</option>
        </select>
      </div>

      <!-- CATALOGUE TOOLBAR -->
      <div class="catalogue-toolbar">

        <div class="catalogue-summary">
          <strong data-product-count>
            {publicProducts.length} public products
          </strong>

          <span>
            Hidden products stay in the backend and do not
            appear here.
          </span>
        </div>

        <div class="grid-density">
          <div class="grid-density-copy">
            <strong>View</strong>
            <span>Products per row</span>
          </div>

          <div
            class="grid-density-controls"
            role="group"
            aria-label="Products per row"
          >
            <button
              type="button"
              class="grid-density-button"
              data-grid-columns="1"
              aria-label="1 product per row"
              aria-pressed="false"
            >
              1
            </button>

            <button
              type="button"
              class="grid-density-button"
              data-grid-columns="2"
              aria-label="2 products per row"
              aria-pressed="false"
            >
              2
            </button>

            <button
              type="button"
              class="grid-density-button"
              data-grid-columns="3"
              aria-label="3 products per row"
              aria-pressed="false"
            >
              3
            </button>

            <button
              type="button"
              class="grid-density-button"
              data-grid-columns="4"
              aria-label="4 products per row"
              aria-pressed="false"
            >
              4
            </button>

            <button
              type="button"
              class="grid-density-button"
              data-grid-columns="5"
              aria-label="5 products per row"
              aria-pressed="false"
            >
              5
            </button>

            <button
              type="button"
              class="grid-density-button"
              data-grid-columns="6"
              aria-label="6 products per row"
              aria-pressed="false"
            >
              6
            </button>
          </div>
        </div>
      </div>

      <!-- PRODUCT GRID -->
      <div
        class="product-catalogue-grid"
        data-product-grid
        data-columns="4"
      >
        {
          publicProducts.map(p => (
            <article
              class="card product-card"
              data-product-card
              data-name={p.name.toLowerCase()}
              data-platforms={p.platforms
                .join("|")
                .toLowerCase()}
              data-price={
                p.showPrice
                  ? (p.price > 0 ? "paid" : "free")
                  : "hidden"
              }
              data-availability={p.availability
                .toLowerCase()
                .replace(/\s+/g, "-")}
            >
              <div class="product-image">
                <img
                  src={`${base}images/hero-laptop.png`}
                  alt=""
                />
              </div>

              <div class="product-meta">
                <span class="pill">
                  {p.type}
                </span>

                {p.platforms.slice(0, 2).map(x => (
                  <span class="pill">
                    {x}
                  </span>
                ))}
              </div>

              <h3>{p.name}</h3>

              <p>{p.short}</p>

              {
                p.showPrice ? (
                  <strong>{p.priceLabel}</strong>
                ) : (
                  <span class="meta">
                    Price hidden
                  </span>
                )
              }

              <a
                class="button button-small"
                href={`${base}products/${p.slug}/`}
              >
                View details
              </a>
            </article>
          ))
        }
      </div>

    </div>
  </section>

  <script is:inline>
    const grid =
      document.querySelector('[data-product-grid]');

    const cards = [
      ...document.querySelectorAll(
        '[data-product-card]'
      )
    ];

    const search =
      document.querySelector(
        '[aria-label="Search products"]'
      );

    const platform =
      document.querySelector(
        '[aria-label="Platform"]'
      );

    const price =
      document.querySelector(
        '[aria-label="Price"]'
      );

    const availability =
      document.querySelector(
        '[aria-label="Availability"]'
      );

    const count =
      document.querySelector(
        '[data-product-count]'
      );

    const densityButtons = [
      ...document.querySelectorAll(
        '[data-grid-columns]'
      )
    ];

    const normalize = value =>
      value
        .toLowerCase()
        .replace(/\s+/g, '-');

    /* =========================
       GRID DENSITY
    ========================= */

    const applyGridDensity = columns => {
      if (!grid) return;

      const requested =
        Number(columns);

      if (!Number.isFinite(requested)) {
        return;
      }

      const isMobile =
        window.matchMedia(
          '(max-width: 600px)'
        ).matches;

      const maximum =
        isMobile ? 3 : 6;

      const safeColumns =
        Math.min(
          maximum,
          Math.max(
            1,
            Math.round(requested)
          )
        );

      grid.dataset.columns =
        String(safeColumns);

      densityButtons.forEach(button => {
        const buttonColumns =
          Number(
            button.dataset.gridColumns
          );

        const active =
          buttonColumns === safeColumns;

        button.classList.toggle(
          'is-active',
          active
        );

        button.setAttribute(
          'aria-pressed',
          String(active)
        );
      });
    };

    /*
      Desktop default: 4
      Phone default: 2
    */

    const setDefaultGridDensity = () => {
      const isMobile =
        window.matchMedia(
          '(max-width: 600px)'
        ).matches;

      applyGridDensity(
        isMobile ? 2 : 4
      );
    };

    setDefaultGridDensity();

    densityButtons.forEach(button => {
      button.addEventListener(
        'click',
        () => {
          const columns =
            Number(
              button.dataset.gridColumns
            );

          applyGridDensity(columns);
        }
      );
    });

    window.addEventListener(
      'resize',
      () => {
        const isMobile =
          window.matchMedia(
            '(max-width: 600px)'
          ).matches;

        const current =
          Number(
            grid?.dataset.columns || 4
          );

        if (isMobile && current > 3) {
          applyGridDensity(3);
        }
      }
    );

    /* =========================
       PRODUCT FILTERS
    ========================= */

    const filter = () => {
      const query =
        (search?.value || '')
          .trim()
          .toLowerCase();

      const platformValue =
        (platform?.value ||
          'All platforms')
          .toLowerCase();

      const priceValue =
        (price?.value ||
          'All prices')
          .toLowerCase();

      const availabilityValue =
        normalize(
          availability?.value ||
            'All availability'
        );

      let visible = 0;

      cards.forEach(card => {
        const matchesQuery =
          !query ||
          card.dataset.name
            .includes(query);

        const matchesPlatform =
          platformValue ===
            'all platforms' ||
          card.dataset.platforms
            .split('|')
            .includes(
              platformValue
            );

        const matchesPrice =
          priceValue ===
            'all prices' ||
          (
            normalize(priceValue) ===
              'hidden-price'
              ? card.dataset.price ===
                'hidden'
              : card.dataset.price ===
                normalize(priceValue)
          );

        const matchesAvailability =
          availabilityValue ===
            'all-availability' ||
          card.dataset.availability ===
            availabilityValue;

        const show =
          matchesQuery &&
          matchesPlatform &&
          matchesPrice &&
          matchesAvailability;

        card.hidden = !show;

        if (show) {
          visible += 1;
        }
      });

      if (count) {
        count.textContent =
          `${visible} public product${
            visible === 1
              ? ''
              : 's'
          }`;
      }
    };

    [
      search,
      platform,
      price,
      availability
    ].forEach(control => {
      control?.addEventListener(
        'input',
        filter
      );
    });

    [
      platform,
      price,
      availability
    ].forEach(control => {
      control?.addEventListener(
        'change',
        filter
      );
    });

    filter();
  </script>
</BaseLayout>
