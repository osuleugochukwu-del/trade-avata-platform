---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/site.js';
const publicProducts = products.filter(p=>p.visible);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Products — Trade Avata"><section class="page-hero"><div class="container"><span class="eyebrow">Products</span><h1>Products for smarter trading.</h1><p>Browse indicators, applications, tools and resources. The production catalogue will be controlled from the Trade Avata backend.</p></div></section><section class="section"><div class="container"><div class="filter-bar"><input aria-label="Search products" placeholder="Search products…" /><select aria-label="Platform"><option>All platforms</option><option>Web</option><option>cTrader</option><option>MT5</option><option>Windows</option><option>Android</option></select><select aria-label="Price"><option>All prices</option><option>Free</option><option>Paid</option><option>Hidden price</option></select><select aria-label="Availability"><option>All availability</option><option>Available</option><option>Coming soon</option><option>Planned</option></select></div><div class="section-head"><div><strong data-product-count>{publicProducts.length} public products</strong><p>Hidden products stay in the backend and do not appear here.</p></div></div><div class="grid-3" data-product-grid>{publicProducts.map(p=><article class="card product-card" data-product-card data-name={p.name.toLowerCase()} data-platforms={p.platforms.join("|").toLowerCase()} data-price={p.showPrice ? (p.price > 0 ? "paid" : "free") : "hidden"} data-availability={p.availability.toLowerCase().replace(/\s+/g,"-")}><div class="product-image"><img src={`${base}images/hero-laptop.png`} alt="" /></div><div class="product-meta"><span class="pill">{p.type}</span>{p.platforms.slice(0,2).map(x=><span class="pill">{x}</span>)}</div><h3>{p.name}</h3><p>{p.short}</p>{p.showPrice ? <strong>{p.priceLabel}</strong> : <span class="meta">Price hidden</span>}<a class="button button-small" href={`${base}products/${p.slug}/`}>View details</a></article>)}</div></div></section><script is:inline>
  const grid = document.querySelector('[data-product-grid]');
  const cards = [...document.querySelectorAll('[data-product-card]')];
  const search = document.querySelector('[aria-label="Search products"]');
  const platform = document.querySelector('[aria-label="Platform"]');
  const price = document.querySelector('[aria-label="Price"]');
  const availability = document.querySelector('[aria-label="Availability"]');
  const count = document.querySelector('[data-product-count]');
  const normalize = value => value.toLowerCase().replace(/\s+/g, '-');
  const filter = () => {
    const query = (search?.value || '').trim().toLowerCase();
    const platformValue = (platform?.value || 'All platforms').toLowerCase();
    const priceValue = (price?.value || 'All prices').toLowerCase();
    const availabilityValue = normalize(availability?.value || 'All availability');
    let visible = 0;
    cards.forEach(card => {
      const matchesQuery = !query || card.dataset.name.includes(query);
      const matchesPlatform = platformValue === 'all platforms' || card.dataset.platforms.split('|').includes(platformValue);
      const matchesPrice = priceValue === 'all prices' || (normalize(priceValue) === 'hidden-price' ? card.dataset.price === 'hidden' : card.dataset.price === normalize(priceValue));
      const matchesAvailability = availabilityValue === 'all-availability' || card.dataset.availability === availabilityValue;
      const show = matchesQuery && matchesPlatform && matchesPrice && matchesAvailability;
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (count) count.textContent = `${visible} public product${visible === 1 ? '' : 's'}`;
  };
  [search, platform, price, availability].forEach(control => control?.addEventListener('input', filter));
  [platform, price, availability].forEach(control => control?.addEventListener('change', filter));
  filter();
</script>
</BaseLayout>
