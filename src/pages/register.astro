---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Register — Trade Avata" description="Create a Trade Avata account.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Account</span><h1>Create your Trade Avata account.</h1><p>Create one account for your profile, products, courses, progress and future subscriptions.</p></div></section>
  <section class="section"><div class="container" style="max-width:520px">
    <form class="card form" id="register-form">
      <div class="account-provider"><button class="button button-outline" id="google-register" type="button">Continue with Google</button><span>or use email</span></div>
      <label>Full name<input id="register-name" autocomplete="name" required /></label>
      <label>Email<input id="register-email" type="email" autocomplete="email" required /></label>
      <label>Password<input id="register-password" type="password" minlength="8" autocomplete="new-password" required /></label>
      <label class="checkbox-row"><input id="register-consent" type="checkbox" required /> <span>I agree to the <a class="text-link" href="../terms/">Terms</a> and <a class="text-link" href="../privacy/">Privacy Policy</a>.</span></label>
      <button class="button" type="submit">Create account</button>
      <a class="text-link" href="../login/">Already have an account? Log in →</a>
      <p class="form-status" id="register-status" aria-live="polite"></p>
    </form>
  </div></section>
</BaseLayout>
<script>
  import { loginWithGoogle, registerWithEmail } from '../lib/firebase/auth.js';

  const form = document.querySelector('#register-form');
  const name = document.querySelector('#register-name');
  const email = document.querySelector('#register-email');
  const password = document.querySelector('#register-password');
  const google = document.querySelector('#google-register');
  const status = document.querySelector('#register-status');

  function showStatus(message, error = false) {
    status.textContent = message;
    status.dataset.error = error ? 'true' : 'false';
  }

  function friendlyError(error) {
    const messages = {
      'auth/email-already-in-use': 'An account already exists for this email.',
      'auth/invalid-email': 'Enter a valid email address.',
      'auth/weak-password': 'Choose a stronger password with at least 8 characters.',
      'auth/network-request-failed': 'A network error occurred. Check your connection and try again.'
    };
    return messages[error?.code] || error?.message || 'Something went wrong. Please try again.';
  }

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    showStatus('Creating your account…');
    try {
      await registerWithEmail(email.value, password.value, name.value);
      window.location.href = '../account/';
    } catch (error) {
      showStatus(friendlyError(error), true);
    }
  });

  google?.addEventListener('click', async () => {
    showStatus('Opening Google sign-in…');
    try {
      const user = await loginWithGoogle();
      if (user) window.location.href = '../account/';
    } catch (error) {
      showStatus(friendlyError(error), true);
    }
  });
</script>
