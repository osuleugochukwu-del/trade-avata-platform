---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Register — Trade Avata"><section class="page-hero"><div class="container"><span class="eyebrow">Account</span><h1>Create your Trade Avata account.</h1><p>Registration and Google sign-in will connect to Firebase in the account phase.</p></div></section><section class="section"><div class="container" style="max-width:520px"><form class="card form"><label>Full name<input /></label><label>Email<input type="email" /></label><label>Password<input type="password" /></label><button class="button" type="button">Create account</button></form></div></section></BaseLayout>
