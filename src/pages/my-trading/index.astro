  </style>

  <script>
    const base = import.meta.env.BASE_URL;
    const buttons = [...document.querySelectorAll('[data-view]')];
    const panels = [...document.querySelectorAll('[data-panel]')];

    function show(id){
      panels.forEach(p=>p.classList.toggle('active',p.dataset.panel===id));
      buttons.forEach(b=>b.classList.toggle('active',b.dataset.view===id));
      history.replaceState(null,'','#'+id);
      window.scrollTo({top:0,behavior:'smooth'});
    }
    buttons.forEach(b=>b.addEventListener('click',()=>show(b.dataset.view)));
    show(location.hash.replace('#','') || 'dashboard');

    function csvDownload(name, rows){
      const csv = rows.map(r=>r.map(v=>`"${String(v).replaceAll('"','""')}"`).join(',')).join('\\n');
      const blob = new Blob([csv],{type:'text/csv;charset=utf-8'});
      const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=name+'.csv'; a.click();
      setTimeout(()=>URL.revokeObjectURL(a.href),1000);
    }
    function pdfPrint(title){
      const w=window.open('','_blank','width=900,height=800');
      if(!w){alert('Please allow pop-ups to generate the PDF.');return;}
      w.document.write(`<html><head><title>${title} — Trade Avata</title><style>
      body{font-family:Arial,sans-serif;padding:36px;color:#0f172a}h1{font-size:25px}h2{font-size:16px;margin-top:26px}
      .meta{color:#64748b;font-size:12px;margin-bottom:25px}.box{border:1px solid #ddd;border-radius:8px;padding:15px;margin:10px 0}
      table{width:100%;border-collapse:collapse}td,th{padding:9px;border-bottom:1px solid #ddd;text-align:left;font-size:11px}
      </style></head><body><h1>Trade Avata — ${title}</h1><div class="meta">Generated from My Trading · ${new Date().toLocaleString()}</div>
      <div class="box"><b>Account</b><br>My Trading Account · USD<br><br><b>Equity:</b> $12,846.20 &nbsp; <b>Net P&amp;L:</b> +$2,846.20 &nbsp; <b>Win Rate:</b> 64.2%</div>
      <h2>Report</h2><p>This PDF is a downloadable report generated from the selected Trade Avata analysis view. Production account data will populate these values from the connected account.</p>
      <h2>Key metrics</h2><table><tr><th>Metric</th><th>Value</th></tr><tr><td>Trades</td><td>321</td></tr><tr><td>Profit Factor</td><td>1.84</td></tr><tr><td>Max Drawdown</td><td>-8.7%</td></tr><tr><td>Expectancy</td><td>+$24.80</td></tr></table>
      <script>window.onload=()=>setTimeout(()=>window.print(),300)<\/script></body></html>`);
      w.document.close();
    }
    document.querySelectorAll('[data-export]').forEach(b=>{
      b.addEventListener('click',()=>{
        const type=b.dataset.export;
        if(type.endsWith('-xlsx') || type==='complete-xlsx'){
          csvDownload('trade-avata-'+type.replace('-xlsx',''),[
            ['Trade Avata','My Trading Export'],['Generated',new Date().toISOString()],['Equity','$12,846.20'],['Net P&L','$2,846.20'],['Win Rate','64.2%'],['Profit Factor','1.84'],['Max Drawdown','-8.7%']
          ]);
        } else {
          pdfPrint(type==='complete'?'Complete Trading Report':type.charAt(0).toUpperCase()+type.slice(1)+' Report');
        }
      });
    });
    ['connectBtn','connect2','connect3'].forEach(id=>document.getElementById(id)?.addEventListener('click',()=>alert('Account connection is ready for the real provider/CSV connector layer.')));
    document.getElementById('syncBtn')?.addEventListener('click',()=>alert('Sync will use the connected account provider once the live connector is configured.'));
    document.getElementById('reportBtn')?.addEventListener('click',()=>pdfPrint('Monthly Trading Report'));
  </script>
</BaseLayout>
