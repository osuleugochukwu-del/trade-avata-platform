---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Log in — Trade Avata" description="Log in to your Trade Avata account.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Account</span><h1>Welcome back.</h1><p>Access your Trade Avata profile, purchases, entitlements and learning progress.</p></div></section>
  <section class="section"><div class="container" style="max-width:520px">
    <form class="card form" id="login-form">
      <div class="account-provider"><button class="button button-outline" id="google-login" type="button">Continue with Google</button><span>or use email</span></div>
      <label>Email<input id="login-email" type="email" autocomplete="email" required /></label>
      <label>Password<input id="login-password" type="password" autocomplete="current-password" required /></label>
      <button class="button" type="submit">Log in</button>
      <button class="text-link text-button" id="reset-password" type="button">Forgot your password?</button>
      <a class="text-link" href="../register/">Create an account →</a>
      <p class="form-status" id="login-status" aria-live="polite"></p>
    </form>
  </div></section>
</BaseLayout>
<script>
  import { loginWithEmail, loginWithGoogle, resetPassword } from '../lib/firebase/auth.js';

  const form = document.querySelector('#login-form');
  const email = document.querySelector('#login-email');
  const password = document.querySelector('#login-password');
  const google = document.querySelector('#google-login');
  const reset = document.querySelector('#reset-password');
  const status = document.querySelector('#login-status');

  function showStatus(message, error = false) {
    status.textContent = message;
    status.dataset.error = error ? 'true' : 'false';
  }

  function friendlyError(error) {
    const messages = {
      'auth/invalid-credential': 'The email or password is incorrect.',
      'auth/invalid-email': 'Enter a valid email address.',
      'auth/too-many-requests': 'Too many attempts. Please wait and try again.',
      'auth/user-disabled': 'This account has been disabled.',
      'auth/network-request-failed': 'A network error occurred. Check your connection and try again.'
    };
    return messages[error?.code] || error?.message || 'Something went wrong. Please try again.';
  }

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    showStatus('Signing you in…');
    try {
      await loginWithEmail(email.value, password.value);
      window.location.href = '../account/';
    } catch (error) {
      showStatus(friendlyError(error), true);
    }
  });

  google?.addEventListener('click', async () => {
    showStatus('Opening Google sign-in…');
    try {
      const user = await loginWithGoogle();
      if (user) window.location.href = '../account/';
    } catch (error) {
      showStatus(friendlyError(error), true);
    }
  });

  reset?.addEventListener('click', async () => {
    if (!email.value.trim()) {
      showStatus('Enter your email first, then choose password reset.', true);
      email.focus();
      return;
    }
    showStatus('Sending password reset email…');
    try {
      await resetPassword(email.value);
      showStatus('Password reset instructions have been sent if the account exists.');
    } catch (error) {
      showStatus(friendlyError(error), true);
    }
  });
</script>
