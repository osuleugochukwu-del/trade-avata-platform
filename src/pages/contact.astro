---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Trade Avata"><section class="page-hero"><div class="container"><span class="eyebrow">Support</span><h1>Get in touch.</h1><p>Have a question about a product, tool or future release? Send a message.</p></div></section><section class="section"><div class="container detail-grid"><div class="card"><h3>Trade Avata Support</h3><p>Product support, general questions and partnership enquiries will eventually connect to the backend support system.</p><p class="meta">Email: support@tradeavata.com</p></div><form class="card form"><label>Full name<input required /></label><label>Email<input type="email" required /></label><label>Subject<input required /></label><label>Message<textarea required></textarea></label><button class="button" type="submit">Send message</button></form></div></section></BaseLayout>
