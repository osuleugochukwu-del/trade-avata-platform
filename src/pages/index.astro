---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products, tools, courses } from '../data/site.js';
const featured = products.filter(p => p.visible && p.featured).slice(0,4);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Trade Avata — Trade Simple." description="Trade Avata builds trading technology, products, tools, applications, education and solutions that make trading simpler.">
  <section class="hero"><div class="container hero-grid"><div><span class="eyebrow">Trading technology & products</span><h1>Better Tools.<br /><span>Smarter Trading.</span></h1><p>Powerful indicators, trading applications, practical tools and education designed to help you trade with more clarity and consistency.</p><div class="actions"><a class="button" href={`${base}products/`}>Explore Products</a><a class="button button-outline" href={`${base}tools/`}>View Tools</a></div></div><div class="hero-visual"><img src={`${base}images/hero-laptop.png`} alt="Trading workstation with market charts" /><div class="hero-caption"><strong>Built around simplicity.</strong><p>One Trade Avata identity across products, tools, applications and education.</p></div></div></div></section>
  <div class="container stats"><div class="stat"><strong>Products</strong><span>Indicators, tools & applications</span></div><div class="stat"><strong>Tools</strong><span>Practical trading utilities</span></div><div class="stat"><strong>Learning</strong><span>Courses and guided resources</span></div><div class="stat"><strong>Blue-first</strong><span>One consistent company identity</span></div></div>
  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Featured products</span><h2>Tools built to make trading simpler.</h2><p>The catalogue is designed to grow. Products can later be created, hidden, published and managed from the backend.</p></div><a class="text-link" href={`${base}products/`}>View all products →</a></div><div class="cards">{featured.map(p=><article class="card product-card"><div class="product-image"><img src={`${base}images/hero-laptop.png`} alt="" /></div><div class="product-meta"><span class="pill">{p.type}</span><span class="pill">{p.platforms[0]}</span></div><h3>{p.name}</h3><p>{p.short}</p><a class="button button-small button-outline" href={`${base}products/${p.slug}/`}>View details</a></article>)}</div></div></section>
  <section class="container feature-banner"><div><span class="eyebrow">Trade Avata platform</span><h2>One company. Many useful products.</h2><p>Start with practical tools and products today, then expand into applications, education, market workspaces and future trading technology.</p></div><a class="button" href={`${base}company/`}>About Trade Avata</a></section>
  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Tools</span><h2>Useful utilities, not clutter.</h2><p>A compact tools layer that can expand as new Trade Avata utilities are released.</p></div><a class="text-link" href={`${base}tools/`}>Explore tools →</a></div><div class="tool-grid">{tools.slice(0,6).map(t=><article class="card"><div class="tool-icon">TA</div><h3>{t.name}</h3><p>{t.description}</p><a class="text-link" href={`${base}tools/${t.slug}/`}>Open tool →</a></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Learning</span><h2>Learn with a clear path.</h2><p>Education supports the products and tools we build, without defining the whole company.</p></div><a class="text-link" href={`${base}learn/`}>View learning →</a></div><div class="grid-3">{courses.map(c=><article class="card course-card"><div class="product-image"><img src={`${base}images/hero-laptop.png`} alt="Trading workstation" /></div><span class="pill">{c.level}</span><h3>{c.title}</h3><p>{c.description}</p><div class="meta-row"><span>{c.modules} modules</span><span>{c.lessons} lessons</span><span>{c.duration}</span></div><a class="button button-small button-outline" href={`${base}learn/${c.slug}/`}>Explore course</a></article>)}</div></div></section>

</BaseLayout>
