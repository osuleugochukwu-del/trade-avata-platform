rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role in ['admin', 'staff'];
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isPublic(resource) {
      return resource.data.public == true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt', 'lastLoginAt'
        ]);
      allow update: if isOwner(userId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'updatedAt', 'lastLoginAt'
        ]);
      allow delete: if isAdmin();
    }

    match /roles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isPublic(resource) || isAdmin();
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isPublic(resource) || isAdmin();
      allow write: if isAdmin();
    }

    match /courses/{courseId}/modules/{moduleId} {
      allow read: if isAdmin() || resource.data.public == true;
      allow write: if isAdmin();
    }

    match /courses/{courseId}/modules/{moduleId}/lessons/{lessonId} {
      allow read: if isAdmin() || resource.data.public == true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isPublic(resource) || isAdmin();
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if isPublic(resource) || isAdmin();
      allow write: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if isAdmin() || resource.data.public == true;
      allow write: if isAdmin();
    }

    match /featureFlags/{flagId} {
      allow read: if isAdmin() || resource.data.public == true;
      allow write: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if isAdmin();
    }

    match /progress/{progressId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if isAdmin();
    }

    match /entitlements/{entitlementId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
